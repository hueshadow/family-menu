{
  "name": "family-menu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:cf": "npx opennextjs-cloudflare && node scripts/wrap-with-cron.mjs",
    "deploy": "npm run build:cf && wrangler deploy",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "ip": "node -e \"const o=require('os').networkInterfaces();for(const k in o)for(const i of o[k])if(i.family==='IPv4'&&!i.internal)console.log(' http://'+i.address+':3000  ('+k+')')\"",
    "lint": "eslint",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "smoke": "node --env-file=.env.local scripts/smoke-menu.mjs",
    "smoke:ai": "node --env-file=.env.local scripts/smoke-ai.mjs",
    "smoke:gen": "node --env-file=.env.local scripts/smoke-gen.mjs",
    "smoke:health": "node --env-file=.env.local scripts/smoke-health.mjs",
    "batch:reports": "node --env-file=.env.local scripts/batch-process-reports.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@supabase/supabase-js": "^2.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pg": "^8.20.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
