# Copy to .env.local and fill in real values. NEVER commit real secrets.
#
# For Cloudflare Workers deployment, use:
#   npx wrangler secret put AI_API_KEY
#   npx wrangler secret put SUPABASE_SECRET_KEY
# Public vars go in wrangler.toml [vars].

# === AI Provider (OpenAI compatible) ===
AI_BASE_URL=https://sub2api.dogbooks.co
AI_API_KEY=sk-replace-me
AI_MODEL_PRIMARY=gpt-5.5
AI_MODEL_VISION=gpt-4o
AI_MODEL_CHEAP=gpt-4o-mini
# Image generation model (dish photos, table photos). Defaults to gpt-image-2 if unset.
AI_MODEL_IMAGE=gpt-image-2

# === Supabase (App Router — client + server) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# === Database (local dev — Workers use Hyperdrive binding) ===
# Required by standalone scripts (gen-dish-photos.mjs, gen-table-photos.mjs,
# compose-menu-board.mjs, batch-process-reports.mjs).
# Find these in Supabase → Project Settings → Database.
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# === Cloudflare R2 ===
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# === Family gate (light auth — replace with a non-trivial value) ===
FAMILY_GATE_CODE=change-me

# === Health reports (DEFERRED — requires pdftotext binary, unavailable on Workers) ===
# HEALTH_REPORTS_DIR=/path/to/reports
